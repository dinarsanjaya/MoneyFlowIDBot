# =============================================
# MoneyFlowID Bot - Environment Configuration
# =============================================
# Salin file ini menjadi .env dan isi nilainya
# Copy this file to .env and fill in the values

# ----------------------------
# Telegram Bot Token
# Dapatkan dari @BotFather di Telegram
# Get from @BotFather on Telegram
# ----------------------------
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ----------------------------
# AI Provider
# custom = OpenAI-compatible endpoint, gemini = Google Gemini
# ----------------------------
AI_PROVIDER=custom

# ----------------------------
# Custom AI (OpenAI-compatible /v1/chat/completions)
# CUSTOM_AI_API_KEY boleh kosong jika server tidak butuh auth
# CUSTOM_AI_API_KEY can be empty if the server does not require auth
# ----------------------------
CUSTOM_AI_BASE_URL=http://143.14.13.43:1430/v1
CUSTOM_AI_MODEL=kiro/claude-haiku-4.5-agentic
CUSTOM_AI_API_KEY=

# ----------------------------
# Gemini AI fallback (pakai jika AI_PROVIDER=gemini)
# Get from https://aistudio.google.com/
# ----------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash


# ----------------------------
# Google Service Account Credentials
# Path ke file JSON credentials Google Service Account
# Path to Google Service Account credentials JSON file
# ----------------------------
GOOGLE_CREDENTIALS_PATH=./credentials/google-credentials.json

# ----------------------------
# Admin Telegram User ID (opsional / optional)
# Untuk akses perintah admin
# For admin command access
# ----------------------------
BOT_ADMIN_ID=123456789

# ----------------------------
# Bahasa default bot (id / en)
# Default bot language (id / en)
# ----------------------------
DEFAULT_LANGUAGE=id

# ----------------------------
# Timezone untuk reminder tagihan
# Timezone for bill reminders (e.g. Asia/Jakarta)
# ----------------------------
TIMEZONE=Asia/Jakarta
